// Path Traversal
const fs = require("fs");
app.get("/readfile", (req, res) => {
  const file = req.query.file;
  const data = fs.readFileSync("./files/" + file, "utf8");
  res.send(data);
});

app.listen(3000, () => {
  console.log("Vulnerable test app running on port 3000");
});
